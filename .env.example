# === ОБЯЗАТЕЛЬНЫЕ ===

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Telegram бот — @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === БАЗА ДАННЫХ (Upstash Redis) ===
# https://console.upstash.com → Create Database → REST API
# Используется для: список пользователей, push-уведомления, rate limit, аналитика, RAG юриста
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# === БЕЗОПАСНОСТЬ ===
# Защита Vercel Cron — случайная строка
CRON_SECRET=any_random_long_string_here

# Пароль для админ-страниц (дашборд, seed) — случайная строка
ADMIN_PASSWORD=your_admin_password_here

# === ОПЦИОНАЛЬНО ===
# NEXT_PUBLIC_APP_URL=https://qamqor.vercel.app
