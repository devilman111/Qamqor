# === ОБЯЗАТЕЛЬНЫЕ ===

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Telegram бот — @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === БАЗА ДАННЫХ ===
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# === БЕЗОПАСНОСТЬ ===
# Защита Vercel Cron
CRON_SECRET=any_random_long_string_here

# Пароль для админ-страниц
ADMIN_PASSWORD=your_admin_password_here

# КЛЮЧ ШИФРОВАНИЯ — для шифрования истории чатов пользователей
# Сгенерировать: openssl rand -hex 32
# ИЛИ в Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Должен быть 64 hex-символа. НИКОГДА не меняйте после установки — потеряете доступ к зашифрованным данным
ENCRYPTION_KEY=64_hex_characters_long_random_key

# === URL ===
NEXT_PUBLIC_APP_URL=https://qamqor-seven.vercel.app
