# Скопируйте этот файл в .env.local и заполните значения
# НЕ коммитьте .env.local в git!

# Google AI Studio API ключ (получить: https://aistudio.google.com/app/apikey)
# Бесплатный тариф: 1500 запросов/день на Gemini 2.5 Flash
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Токен Telegram бота (получить через @BotFather командой /newbot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
